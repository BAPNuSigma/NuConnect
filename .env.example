TURSO_DATABASE_URL=libsql://your-database.turso.io
TURSO_AUTH_TOKEN=your-token
GMAIL_USER=
GMAIL_APP_PASSWORD=
GOOGLE_FORMS_WEBHOOK_SECRET=

# Lead search (Find Leads page). Set either or both — results are merged and deduped.
# Brave (primary): Search plan, $5/month renewing credit (~1,000 queries), card required, no
# built-in spend cap — so this app enforces its own monthly limit below. Get a key at
# https://api.search.brave.com/app/keys.
BRAVE_API_KEY=
BRAVE_MONTHLY_QUERY_CAP=900

# Google (optional, only if you already have an eligible Cloud project — the Custom Search
# JSON API is closed to new signups as of 2025 and fully retires 2027-01-01).
# 1. Create a Programmable Search Engine at https://programmablesearchengine.google.com/ (search the entire web) and copy its Search engine ID.
# 2. Create an API key for the Custom Search JSON API at https://console.cloud.google.com/apis/credentials.
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_ID=
